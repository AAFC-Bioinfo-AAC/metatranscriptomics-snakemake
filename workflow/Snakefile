#Resolve with respect to PROJECT_ROOT
def relpath(cfg_key):
    """Resolve a config path relative to PROJECT_ROOT."""
    path = os.path.expandvars(os.path.expanduser(os.fspath(config[cfg_key])))
    return os.path.abspath(os.path.join(PROJECT_ROOT, path))
CONDA_PREFIX = relpath("conda_prefix")
LOG_DIR = relpath("log_files")
SOFTWARE_VERSIONS = relpath("software_versions")
READS_DIR = relpath("reads_dir")
HOST_DEP_DIR = relpath("reads_host_dep")
RRNA_DEP_DIR = relpath("reads_rRNA_dep")
KRAKEN_OUTPUT_DIR = relpath("kraken_short_reads_dir")
BRACKEN_OUTPUT_DIR = relpath("bracken_short_reads_dir")
CARD_RGI_OUTPUT_DIR = relpath("amr_screening_dir")
ASSEMBLIES_DIR = relpath("assemblies_dir")
RNAQUAST_DIR = relpath("rnaquast_dir")
MEGAHIT_DIR = relpath("co-assembly_dir")
COASSEMBLY_INDEX = relpath("coassembly_index")
ASSEMBLY_MAPPING = relpath("sorted_bam_dir")
PRODIGAL_DIR = relpath("prodigal_dir")
FEATURECOUNTS_DIR = relpath("featurecounts_dir")

BOWTIE_INDEX      = relpath("bowtie2_index")
BOWTIE_INDEX_FILES= [f"{BOWTIE_INDEX}.{i}.bt2" for i in (1,2,3,4)] + \
                    [f"{BOWTIE_INDEX}.rev.{i}.bt2" for i in (1,2)]

RRNA_DB = relpath("sortmerna_DB")

# Temporary outputs passed between cluster jobs must be on shared storage.
TRIMMED_DIR = relpath("reads_trimmed")

TAXONOMY_DB = relpath("gtbd_DB")
BUSCO_LINEAGES = {
    name: os.path.abspath(os.path.join(PROJECT_ROOT, os.path.expandvars(os.path.expanduser(path))))
    for name, path in config["busco_lineages"].items()
}
LINEAGES = list(BUSCO_LINEAGES.keys())

# Reuse a matched metagenomic assembly when supplied; otherwise assemble RNA.
reference_assembly = config.get("reference_assembly")
COASSEMBLY_FASTA = relpath("reference_assembly") if reference_assembly else f"{MEGAHIT_DIR}/final.contigs.fa"
COASSEMBLY_INDEX_FILES = [f"{COASSEMBLY_INDEX}/coassembly.{part}.bt2" for part in ("1", "2", "3", "4", "rev.1", "rev.2")]

for name, settings in config.items():
    if isinstance(settings, dict) and "threads" in settings:
        value = settings["threads"]
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            raise ValueError(f"{name}.threads must be a positive integer.")
strand = config.get("featurecounts", {}).get("strandedness", 0)
if isinstance(strand, bool) or strand not in (0, 1, 2):
    raise ValueError("featurecounts.strandedness must be 0, 1, or 2.")
memory = config.get("rna_spades", {}).get("memory_gb", 60)
if "memory" in config.get("rna_spades", {}):
    raise ValueError("Replace legacy rna_spades.memory (previously documented as MB) with memory_gb in GB.")
if isinstance(memory, bool) or not isinstance(memory, int) or memory < 1:
    raise ValueError("rna_spades.memory_gb must be a positive integer.")
for key in ("readlen", "threshold_species", "threshold_genus", "threshold_phylum"):
    value = config.get("bracken", {}).get(key, 150 if key == "readlen" else 10)
    if isinstance(value, bool) or not isinstance(value, int) or value < (1 if key == "readlen" else 0):
        raise ValueError(f"bracken.{key} must be an integer {'greater than zero' if key == 'readlen' else 'at least zero'}.")

# -------------------------------------------------------------------
# Sample handling
# -------------------------------------------------------------------

SAMPLESHEET_PATH = os.path.join(CONFIG_DIR, config["samplesheet"])

def load_samples(samplesheet):
    samples = {}
    with open(samplesheet, newline="") as csvfile:
        reader = csv.DictReader(csvfile)
        required = {"sample", "fastq_1", "fastq_2"}
        if not required.issubset(reader.fieldnames or []):
            raise ValueError(f"{samplesheet}: required columns are sample, fastq_1, fastq_2.")
        for line, row in enumerate(reader, start=2):
            values = {key: (row.get(key) or "").strip() for key in required}
            sample = values["sample"]
            if not all(values.values()):
                raise ValueError(f"{samplesheet}:{line}: sample and both read filenames must be nonempty.")
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", sample):
                raise ValueError(f"{samplesheet}:{line}: invalid sample ID {sample!r}.")
            if sample in samples:
                raise ValueError(f"{samplesheet}:{line}: duplicate sample ID {sample!r}.")
            if values["fastq_1"] == values["fastq_2"]:
                raise ValueError(f"{samplesheet}:{line}: read 1 and read 2 must be different files.")
            samples[sample] = {
                "fastq_1": os.path.join(READS_DIR, values["fastq_1"]),
                "fastq_2": os.path.join(READS_DIR, values["fastq_2"]),
            }
    if not samples:
        raise ValueError(f"{samplesheet}: no samples found.")
    return samples

SAMPLES = load_samples(SAMPLESHEET_PATH)
SAMPLE_NAMES = list(SAMPLES.keys())

## Snakemake modules to include ##
